# Скопируйте этот файл в .env и подставьте реальные значения.
# Файл .env НЕ коммитится (см. .gitignore в корне репозитория) и читается
# приложением автоматически через godotenv при запуске из директории backend/.

SERVER_ADDR=:8080

# Строка подключения к PostgreSQL. ОБЯЗАТЕЛЬНА — без неё сервер не запустится.
DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/judging?sslmode=disable

# HMAC-ключ для подписи JWT. ОБЯЗАТЕЛЕН — без него сервер не запустится.
# Сгенерируйте случайное значение, например: openssl rand -hex 32
JWT_SECRET=CHANGE_ME

JWT_EXPIRATION=24h
MIGRATION_PATH=file://migrations
ALLOWED_ORIGINS=*
